---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const withBase = (path?: string) => {
  if (!path) return path;
  if (/^(?:[a-z]+:)?\/\//i.test(path) || path.startsWith("data:") || path.startsWith("blob:")) {
    return path;
  }

  const normalizedPath = path.startsWith("/") ? path.slice(1) : path;
  return `${import.meta.env.BASE_URL}${normalizedPath}`;
};
---

{
  hasExperience && (
    <section id="papers" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Papers
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.experience.map((exp) => {
                const Component = exp.link ? "a" : "div";
                const linkProps = exp.link
                  ? {
                      href: withBase(exp.link),
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <div class="group relative">
                    <Component
                      {...linkProps}
                      class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                        exp.link
                          ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                          : ""
                      }`}
                    >
                      {exp.link && (
                        <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                          <svg
                            class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-6 md:gap-8">
                        {exp.image && (
                          <div class="w-full sm:w-44 h-44 sm:h-36 md:h-40 rounded-lg border border-gray-200 bg-white overflow-hidden flex items-center justify-center text-sm text-gray-500 flex-shrink-0">
                            <img src={withBase(exp.image)} alt={exp.title} class="w-full h-full object-cover" />
                          </div>
                        )}

                        <div class={`space-y-3 ${exp.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}>
                          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 leading-snug">
                            {exp.title}
                          </h3>
                          {exp.company && (
                            <p
                              class="text-base sm:text-lg"
                              style={`color: ${siteConfig.accentColor}`}
                              set:html={exp.company}
                            />
                          )}
                          {exp.authors && (
                            <p class="text-sm sm:text-base text-gray-600" set:html={exp.authors} />
                          )}
                        </div>
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
